<UserControl x:Class="M0DV0IC3.App.Views.KaraokeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:M0DV0IC3.App.ViewModels"
             xmlns:controls="clr-namespace:M0DV0IC3.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:KaraokeViewModel}">
    <DockPanel Margin="6,0,12,12">
        <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,18,0">
                    <ToggleButton Style="{StaticResource OnAirToggle}" HorizontalAlignment="Left" Margin="0,0,0,12"
                                  AutomationProperties.Name="Modo karaoke" IsChecked="{Binding IsOn}" IsEnabled="{Binding IsSupported}"
                                  ToolTip="Quita la voz de lo que suena en Spotify, lo pone en tus cascos y en Discord, y muestra la letra (Ctrl+Alt+K por defecto)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎤" FontFamily="{StaticResource EmojiFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Modo karaoke" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <TextBlock Text="{Binding SongTitle}" FontFamily="{StaticResource HeadingFont}" FontSize="22" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasSong, Converter={StaticResource BoolToVisible}}" />
                    <TextBlock Text="{Binding SongArtist}" Style="{StaticResource MutedText}" FontSize="14" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasSong, Converter={StaticResource BoolToVisible}}" />
                    <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}" />

                    <Border Style="{StaticResource WarningBox}" Margin="0,10,0,0"
                            Visibility="{Binding ShowMonitorWarning, Converter={StaticResource BoolToVisible}}">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"
                                   Text="Para oír la música, elige tus cascos arriba en «AURICULARES · ESCUCHARME»." />
                    </Border>

                    <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="Mientras está activo, Spotify se baja al mínimo en Windows (si no, oirías la canción dos veces, con voz) y vuelve a su volumen al apagarlo. La letra viene de LRCLIB (lrclib.net): solo se envían el artista, el título y la duración." />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <controls:ParamSlider Label="Quitar voz" Minimum="0" Maximum="1" Step="0.05" DefaultValue="1"
                                          Value="{Binding VocalStrength}" Format="{}{0:P0}" OffText="nada"
                                          Hint="Quita lo que suena en el centro de la mezcla, que casi siempre es la voz. Los coros o el eco de la voz pueden quedar." />
                    <controls:ParamSlider Label="Música" Minimum="-40" Maximum="6" Step="1" DefaultValue="-15"
                                          Value="{Binding MusicVolumeDb}" Format="{}{0:+0;-0;0} dB"
                                          Hint="Volumen de la canción, en tus cascos y en Discord." />
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Letra" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding LyricsOffsetText}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="Antes" Command="{Binding LyricsEarlierCommand}" Margin="0,0,6,0"
                                ToolTip="Si la letra va por detrás de la música: la adelanta un cuarto de segundo" />
                        <Button Grid.Column="3" Content="Después" Command="{Binding LyricsLaterCommand}"
                                ToolTip="Si la letra va por delante de la música: la retrasa un cuarto de segundo" />
                    </Grid>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Command="{Binding SingWithAutotuneCommand}" Margin="0,0,8,0"
                                ToolTip="Elige la voz «Autotune cantar»: afinada para cantar encima de una canción">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎶" FontFamily="{StaticResource EmojiFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Cantar con autotune" />
                            </StackPanel>
                        </Button>
                        <Button Content="Buscar otra vez" Command="{Binding RetryCommand}" ToolTip="Vuelve a buscar la letra de esta canción" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- La letra: la línea que toca, grande y en lima; las cantadas, apagadas -->
        <Border Style="{StaticResource CardBorder}" Padding="10,6">
            <ScrollViewer x:Name="LyricsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="LyricsList" ItemsSource="{Binding Lines}" Margin="0,40,0,120" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LyricLineViewModel}">
                            <TextBlock x:Name="Line" Text="{Binding Text}" TextWrapping="Wrap" TextAlignment="Center" Margin="12,5"
                                       FontSize="21" Foreground="{StaticResource TextBrush}" />
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsPast}" Value="True">
                                    <Setter TargetName="Line" Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                    <Setter TargetName="Line" Property="Opacity" Value="0.6" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="Line" Property="Foreground" Value="{StaticResource LimeBrush}" />
                                    <Setter TargetName="Line" Property="FontSize" Value="30" />
                                    <Setter TargetName="Line" Property="FontFamily" Value="{StaticResource HeadingFont}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
