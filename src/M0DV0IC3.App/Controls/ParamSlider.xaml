<UserControl x:Class="M0DV0IC3.App.Controls.ParamSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid Margin="0,2" Background="Transparent" ToolTip="{Binding Hint, ElementName=Root}">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.4" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="118" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="96" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label, ElementName=Root}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <Slider x:Name="Track" ValueChanged="OnTrackValueChanged" Grid.Column="1" VerticalAlignment="Center" Margin="6,0"
                TickFrequency="{Binding Step, ElementName=Root}"
                SmallChange="{Binding Step, ElementName=Root}"
                LargeChange="{Binding Step, ElementName=Root}"
                IsSnapToTickEnabled="True" />
        <TextBlock Grid.Column="2" Text="{Binding ValueText, ElementName=Root}" VerticalAlignment="Center"
                   HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" />
    </Grid>
</UserControl>
