<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>M0DV0IC3.Audio</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Solo las partes de NAudio que se usan (WASAPI, Media Foundation y formatos básicos): menos DLL en la descarga. -->
    <PackageReference Include="NAudio.Core" Version="3.1.0" />
    <!-- OGG Vorbis (los sonidos incluidos y los que añada el usuario): Windows no trae decodificador. -->
    <PackageReference Include="NAudio.Vorbis" Version="3.0.0" />
    <PackageReference Include="NAudio.Wasapi" Version="3.1.0" />
    <!-- Solo usamos su rnnoise.dll nativo (runtimes/win-x64/native); el P/Invoke es propio. -->
    <PackageReference Include="YellowDogMan.RRNoise.NET" Version="0.1.9" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="M0DV0IC3.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\M0DV0IC3.Dsp\M0DV0IC3.Dsp.csproj" />
  </ItemGroup>

</Project>
