<UserControl x:Class="M0DV0IC3.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:M0DV0IC3.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:M0DV0IC3.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="6,0,12,16" MaxWidth="820" HorizontalAlignment="Left">

            <!-- Idioma: los nombres van cada uno en su idioma, para que se encuentre el tuyo aunque no entiendas el otro -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Idioma · Language" Style="{StaticResource SectionHeader}" />
                    <ComboBox ItemsSource="{Binding Languages}" DisplayMemberPath="Name" SelectedValuePath="Code"
                              SelectedValue="{Binding LanguageCode}" Width="230" HorizontalAlignment="Left"
                              AutomationProperties.Name="Idioma · Language" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                Visibility="{Binding LanguageRestartPending, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Text="Se aplica al reiniciar · Applies after restarting" Style="{StaticResource MutedText}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="Reiniciar · Restart" Command="{Binding RestartNowCommand}" Padding="10,4" FontSize="12" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{l:T 'Rango de tu voz'}" Style="{StaticResource SectionHeader}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,10"
                               Text="{l:T 'Ajusta el detector de tono a tu voz. Media (65-900 Hz) sirve para casi todo el mundo; elige Grave solo si tu voz es extremadamente grave (desde 50 Hz) o Aguda si es aguda (120-1000 Hz). Si eliges Aguda con una voz grave, el tono no cambiará o sonará raro.'}" />
                    <WrapPanel>
                        <RadioButton GroupName="Rango" Content="{l:T 'Grave'}" IsChecked="{Binding IsRangeLow}" Margin="0,0,24,0" />
                        <RadioButton GroupName="Rango" Content="{l:T 'Media (recomendado)'}" IsChecked="{Binding IsRangeMedium}" Margin="0,0,24,0" />
                        <RadioButton GroupName="Rango" Content="{l:T 'Aguda'}" IsChecked="{Binding IsRangeHigh}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,0"
                               Text="{l:T 'La latencia de las voces con cambio de tono depende de lo grave que hables: ~11 ms con voz aguda, ~20 ms con voz media, ~27 ms con voz muy grave.'}" />
                    <TextBlock Text="{Binding LearnedPitchText}" TextWrapping="Wrap" Margin="0,10,0,0" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{l:T 'Audio'}" Style="{StaticResource SectionHeader}" />
                    <CheckBox Content="{l:T 'Baja latencia (IAudioClient3)'}" IsChecked="{Binding PreferLowLatency}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="28,2,0,12"
                               Text="{l:T 'Usa periodos de ~3 ms en modo compartido si el driver de la tarjeta de sonido lo admite. Desactívalo solo si oyes cortes.'}" />

                    <CheckBox Content="{l:T 'Modo exclusivo'}" IsChecked="{Binding Exclusive}" />
                    <Border Style="{StaticResource WarningBox}" Margin="28,4,0,12">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}"
                                   Text="{l:T 'Da la latencia más baja, pero bloquea tu micrófono y la salida para las demás aplicaciones mientras M0DV0IC3 esté funcionando. Los auriculares siempre se abren en modo compartido.'}" />
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="230" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{l:T 'Margen anti-cortes'}" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding SafetyMarginOptions}" DisplayMemberPath="Label"
                                  SelectedValuePath="Ms" SelectedValue="{Binding SafetyMarginMs}" />
                    </Grid>
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                               Text="{l:T 'Súbelo si oyes chasquidos o cortes. Cada milisegundo de margen añade 1 ms de latencia.'}" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,10,0,0"
                               Text="{l:T 'Cambiar estas opciones (o los dispositivos) reinicia el audio durante un instante.'}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{l:T 'Ventana'}" Style="{StaticResource SectionHeader}" />
                    <CheckBox Content="{l:T 'Minimizar a la bandeja al cerrar'}" IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,4"
                              ToolTip="{l:T 'Al pulsar la X, M0DV0IC3 sigue funcionando junto al reloj. Para salir: clic derecho en el icono → Salir.'}" />
                    <CheckBox Content="{l:T 'Iniciar minimizado'}" IsChecked="{Binding StartMinimized}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{l:T 'Datos'}" Style="{StaticResource SectionHeader}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8">
                        <Run Text="{l:T 'Ajustes, voces, sonidos y registro de errores se guardan en'}" />
                        <Run Text="{Binding DataFolder, Mode=OneWay}" Foreground="{StaticResource TextBrush}" />
                    </TextBlock>
                    <Button Content="{l:T 'Abrir la carpeta de datos'}" Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
