<UserControl x:Class="M0DV0IC3.App.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:M0DV0IC3.App.Localization">
    <!-- Cada párrafo es un solo texto que traducir; lo que va entre ** sale en negrita (l:Rich.Text). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="6,0,12,16" MaxWidth="820" HorizontalAlignment="Left">

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{l:T 'Cómo funciona'}" Style="{StaticResource SectionHeader}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               l:Rich.Text="{l:T 'M0DV0IC3 coge tu micrófono, le aplica la voz que elijas y la manda a un micrófono virtual: **CABLE Input (VB-Audio Virtual Cable)**. Las demás aplicaciones lo ven como un micrófono más llamado **CABLE Output (VB-Audio Virtual Cable)**. Solo tienes que elegir ese micrófono en Discord, en el juego o en la app que uses.'}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="{l:T 'Para oírte a ti mismo con la voz cambiada, elige tus auriculares arriba, en «Auriculares (escucharme)», y activa «Escucharme» abajo. Usa auriculares, no altavoces: con altavoces el micrófono recogería tu propia voz y se acoplaría.'}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Discord" Style="{StaticResource SectionHeader}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               l:Rich.Text="{l:T '1. Abre **Ajustes de usuario** (la rueda junto a tu nombre) → **Voz y vídeo**.'}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               l:Rich.Text="{l:T '2. En **Dispositivo de entrada** elige **CABLE Output (VB-Audio Virtual Cable)**.'}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               l:Rich.Text="{l:T '3. Desactiva la **supresión de ruido (Krisp)**, la **cancelación de eco** y, si quieres, el control automático de ganancia: Discord cree que los efectos son ruido y los deforma o los corta. Si necesitas quitar ruido, usa «Supresión de ruido» de M0DV0IC3.'}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               l:Rich.Text="{l:T '4. **Sensibilidad de entrada**: desactiva «Determinar automáticamente» y ajusta la barra para que se active al hablar, o usa pulsar para hablar. Con voces de mucho eco o reverb, la detección automática puede cortar el final de las frases.'}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{l:T 'Juegos y otras aplicaciones'}" Style="{StaticResource SectionHeader}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               l:Rich.Text="{l:T 'En las opciones de audio o de voz del juego (o de Teams, Zoom, OBS, el navegador...), elige como micrófono **CABLE Output (VB-Audio Virtual Cable)**. Si el juego no deja elegir micrófono, usa el predeterminado de Windows: Configuración → Sistema → Sonido → Entrada → «CABLE Output».'}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="{l:T 'Los atajos de teclado (pestaña Atajos) funcionan dentro de los juegos. Si el juego se ejecuta como administrador, abre también M0DV0IC3 como administrador.'}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{l:T 'Autotune, voz aleatoria y mantener pulsado'}" Style="{StaticResource SectionHeader}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               l:Rich.Text="{l:T '**Autotune** es el exagerado de los cantantes: al hablar, tu voz salta de nota en nota como si cantaras. Para cantar encima de una canción usa **Autotune cantar**, que no toca tu melodía. Duplica cualquiera de las dos para cambiar la escala, la tonalidad, la velocidad o cuánto se exagera la melodía.'}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               l:Rich.Text="{l:T '**🎲 Aleatoria** (pestaña Voces, o Ctrl+Alt+R) va cambiando sola de voz cada pocos segundos mientras hablas.'}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               l:Rich.Text="{l:T '**Mantener pulsado** (el - del teclado numérico): mientras lo mantienes suena la voz elegida en Voces («Al mantener»); al soltarlo vuelve la que tenías.'}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{l:T 'Música, karaoke y voz del cantante'}" Style="{StaticResource SectionHeader}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               l:Rich.Text="{l:T '**Música por el micro** (pestaña Música, o Ctrl+Alt+P) manda a Discord lo que suena en Spotify u otra app, mezclado con tu voz. Solo se captura esa app, así que nadie se oye a sí mismo.'}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               l:Rich.Text="{l:T '**Modo karaoke** (pestaña Karaoke, o Ctrl+Alt+K): quita la voz de la canción de Spotify, la pone en tus cascos y en Discord y muestra la letra para que cantes encima.'}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               l:Rich.Text="{l:T '**Voz del cantante** (pestaña Música): le cambia la voz a quien canta (Ardilla, Demonio, Robot…) y deja la música como está. Es una voz aparte de la tuya. Va afinada con la canción: el tono solo cambia en octavas, para que la melodía no se salga de la tonalidad.'}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{l:T 'Texto a voz y grabar'}" Style="{StaticResource SectionHeader}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               l:Rich.Text="{l:T '**Texto a voz** (su pestaña): escribe una frase y pulsa Intro. La dice una voz de Windows y suena por el micro con la voz que tengas puesta. Guarda las que más uses y ponles un atajo para decirlas en mitad de una partida.'}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               l:Rich.Text="{l:T '**Grabar** (abajo, o Ctrl+Alt+G) guarda en MP3 lo que sale por el micro, tal y como lo oyen los demás: tu voz, los sonidos, las frases y la música del karaoke. Lo encuentras en Música\\M0DV0IC3, y puedes añadirlo al soundboard.'}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{l:T 'Consejo de Windows: 48000 Hz'}" Style="{StaticResource SectionHeader}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               Text="{l:T 'M0DV0IC3 trabaja a 48000 Hz. Para evitar conversiones (y algo de latencia), pon VB-Cable a esa frecuencia:'}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               l:Rich.Text="{l:T '1. Pulsa Win + R, escribe **mmsys.cpl** y pulsa Intro (Panel de sonido).'}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               l:Rich.Text="{l:T '2. Pestaña **Reproducción** → «CABLE Input» → Propiedades → Opciones avanzadas → **24 bits, 48000 Hz**.'}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               l:Rich.Text="{l:T '3. Pestaña **Grabación** → «CABLE Output» → Propiedades → Opciones avanzadas → **24 bits, 48000 Hz**.'}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="{l:T 'Problemas frecuentes'}" Style="{StaticResource SectionHeader}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               l:Rich.Text="{l:T '**Se oyen chasquidos o cortes** (abajo aparece «cortes: N»): sube el «Margen anti-cortes» en Ajustes, o desactiva «Baja latencia».'}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               l:Rich.Text="{l:T '**Mucha latencia**: pasa el ratón por encima de «Latencia» (abajo a la izquierda) para ver de dónde viene. Las voces con cambio de tono añaden unos 11-27 ms según lo grave que hables, y la supresión de ruido 10 ms más.'}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               l:Rich.Text="{l:T '**La voz suena rara o salta de octava**: revisa el «Rango de tu voz» en Ajustes (Media sirve para casi todo el mundo).'}" />
                    <TextBlock Style="{StaticResource BodyText}"
                               l:Rich.Text="{l:T '**Entra ruido de fondo**: activa «Supresión de ruido» o sube la «Puerta de ruido» hasta que el medidor de salida se quede quieto cuando no hablas.'}" />
                    <TextBlock Style="{StaticResource BodyText}" Margin="0"
                               l:Rich.Text="{l:T '**Algo ha fallado**: el registro de errores está en la carpeta de datos (Ajustes → Abrir la carpeta de datos), en log.txt.'}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
