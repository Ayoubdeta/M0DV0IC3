<UserControl x:Class="M0DV0IC3.App.Views.VoiceEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:M0DV0IC3.App.ViewModels"
             xmlns:controls="clr-namespace:M0DV0IC3.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:VoiceEditorViewModel}">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <Grid>
                <TextBlock Text="Editar voz" Style="{StaticResource SectionHeader}" />
                <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding CloseCommand}" ToolTip="Cerrar el editor" />
            </Grid>
            <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,10"
                       Text="Los cambios se oyen al momento y se guardan solos. Doble clic en un control: valor por defecto." />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Icono" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Icon, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource EmojiFont}"
                             FontSize="18" HorizontalContentAlignment="Center" MaxLength="8"
                             ToolTip="Escribe o pega un emoji (Win + . abre el selector de emojis)" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" FontSize="14" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Deshacer cambios" Command="{Binding UndoCommand}" Margin="0,0,8,0"
                    ToolTip="Vuelve a como estaba la voz al abrir el editor" />
            <Button Content="Quitar efectos" Command="{Binding ClearEffectsCommand}" Margin="0,0,8,0"
                    ToolTip="Deja la voz sin ningún efecto (conserva el nombre y el icono)" />
            <Button Content="Listo" Style="{StaticResource PrimaryButton}" Command="{Binding CloseCommand}" />
        </WrapPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <StackPanel>
                <TextBlock Text="Tono" Style="{StaticResource SubHeader}" />
                <controls:ParamSlider Label="Tono" Minimum="-12" Maximum="12" Step="0.5" DefaultValue="0"
                                      Value="{Binding Pitch}" Format="{}{0:+0.#;-0.#;0} semitonos"
                                      Hint="Más grave (negativo) o más agudo (positivo). 12 semitonos = una octava." />
                <controls:ParamSlider Label="Formantes" Minimum="0.5" Maximum="2" Step="0.01" DefaultValue="1"
                                      Value="{Binding Formant}" Format="{}{0:0.00}×"
                                      Hint="El tamaño de la «garganta»: menos de 1 suena más grande u oscuro; más de 1, más pequeño o brillante." />
                <CheckBox Content="Robot (voz monótona)" IsChecked="{Binding RobotEnabled}" Margin="0,4,0,0" />
                <controls:ParamSlider Label="Nota del robot" Minimum="60" Maximum="300" Step="1" DefaultValue="110"
                                      Value="{Binding RobotHz}" Format="{}{0:0} Hz" IsEnabled="{Binding RobotEnabled}"
                                      Hint="Frecuencia fija a la que habla el robot." />

                <TextBlock Text="Autotune" Style="{StaticResource SubHeader}" />
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="118" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Escala" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" Margin="6,0,0,0" ItemsSource="{Binding Scales}" DisplayMemberPath="Name"
                              SelectedValuePath="Value" SelectedValue="{Binding AutotuneScale}"
                              ToolTip="Notas a las que se ajusta tu voz. «Apagado» quita el autotune." />
                </Grid>
                <Grid Margin="0,2" IsEnabled="{Binding AutotuneKeyEnabled}">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="118" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tonalidad" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" Margin="6,0,0,0" ItemsSource="{Binding Keys}" SelectedIndex="{Binding AutotuneKey}"
                              ToolTip="Pon la tonalidad de la canción si cantas encima de una. La menor = Do mayor (las notas blancas del piano)." />
                </Grid>
                <controls:ParamSlider Label="Velocidad" Minimum="0" Maximum="200" Step="5" DefaultValue="0"
                                      Value="{Binding AutotuneRetuneMs}" Format="{}{0:0} ms" OffText="instantánea"
                                      IsEnabled="{Binding AutotuneEnabled}"
                                      Hint="Instantánea = autotune duro: saltas de nota en nota, como en el reggaetón o el trap. 50-200 ms = corrección natural." />
                <controls:ParamSlider Label="Exagerar melodía" Minimum="0" Maximum="1" Step="0.05" DefaultValue="0"
                                      Value="{Binding AutotuneExaggeration}" Format="{}{0:P0}" OffText="no"
                                      IsEnabled="{Binding AutotuneEnabled}"
                                      Hint="Amplía las subidas y bajadas de tu voz (hasta 2,5×) para que al hablar suene cantado. Si cantas encima de una canción, déjalo en «no»." />

                <TextBlock Text="Vibrato" Style="{StaticResource SubHeader}" />
                <controls:ParamSlider Label="Vibrato" Minimum="0" Maximum="3" Step="0.1" DefaultValue="0"
                                      Value="{Binding VibratoSemitones}" Format="{}±{0:0.0} st" OffText="apagado"
                                      Hint="Hace temblar el tono. Lento y profundo: borracho; rápido y suave: bajo el agua o fantasma." />
                <controls:ParamSlider Label="Vibrato (velocidad)" Minimum="0.2" Maximum="10" Step="0.05" DefaultValue="5.5"
                                      Value="{Binding VibratoHz}" Format="{}{0:0.##} Hz"
                                      Hint="Oscilaciones por segundo." />
                <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="Tono, formantes, robot y autotune añaden algo de latencia, según lo grave que hables: ~11 ms con voz aguda, ~20 ms con voz media, ~27 ms con voz muy grave. El vibrato sin cambio de tono añade de 1 a 20 ms." />

                <TextBlock Text="Efectos" Style="{StaticResource SubHeader}" />
                <controls:ParamSlider Label="Susurro" Minimum="0" Maximum="1" Step="0.01" DefaultValue="0"
                                      Value="{Binding WhisperMix}" Format="{}{0:P0}" OffText="apagado"
                                      Hint="Cambia la vibración de la voz por un soplo con la misma forma de boca. Sin latencia." />
                <controls:ParamSlider Label="Aire (respiración)" Minimum="0" Maximum="1" Step="0.01" DefaultValue="0"
                                      Value="{Binding Breathiness}" Format="{}{0:P0}" OffText="apagado"
                                      Hint="Añade un soplo suave que sigue tu voz: más femenina o susurrada. Sin latencia." />
                <controls:ParamSlider Label="Modulador (Hz)" Minimum="20" Maximum="1000" Step="1" DefaultValue="60"
                                      Value="{Binding RingHz}" Format="{}{0:0} Hz"
                                      Hint="Modulación en anillo: sonido metálico o de alien." />
                <controls:ParamSlider Label="Modulador (mezcla)" Minimum="0" Maximum="1" Step="0.01" DefaultValue="0"
                                      Value="{Binding RingMix}" Format="{}{0:P0}" OffText="apagado" />
                <controls:ParamSlider Label="Distorsión" Minimum="0" Maximum="1" Step="0.01" DefaultValue="0"
                                      Value="{Binding Distortion}" Format="{}{0:P0}" OffText="apagada" />
                <controls:ParamSlider Label="Chorus" Minimum="0" Maximum="1" Step="0.01" DefaultValue="0"
                                      Value="{Binding ChorusMix}" Format="{}{0:P0}" OffText="apagado"
                                      Hint="Tres copias de tu voz con pequeñas variaciones: suena a varias personas a la vez." />
                <controls:ParamSlider Label="Flanger" Minimum="0" Maximum="1" Step="0.01" DefaultValue="0"
                                      Value="{Binding FlangerMix}" Format="{}{0:P0}" OffText="apagado"
                                      Hint="Resonancias que suben y bajan: sonido de avión a reacción o espacial." />
                <controls:ParamSlider Label="Flanger (velocidad)" Minimum="0.05" Maximum="2" Step="0.05" DefaultValue="0.25"
                                      Value="{Binding FlangerHz}" Format="{}{0:0.##} Hz"
                                      Hint="Barridos por segundo." />
                <CheckBox Content="Voz invertida (al revés)" IsChecked="{Binding ReverseEnabled}" Margin="0,4,0,0" />
                <controls:ParamSlider Label="Trozo invertido" Minimum="60" Maximum="500" Step="10" DefaultValue="200"
                                      Value="{Binding ReverseMs}" Format="{}{0:0} ms" IsEnabled="{Binding ReverseEnabled}"
                                      Hint="Cada trozo de esta duración se oye al revés. Para invertirlo hay que esperar a que acabe: añade esa latencia." />

                <TextBlock Text="Ecualización" Style="{StaticResource SubHeader}" />
                <controls:ParamSlider Label="Paso alto" Minimum="0" Maximum="1000" Step="10" DefaultValue="0"
                                      Value="{Binding HighPassHz}" Format="{}{0:0} Hz" OffText="apagado"
                                      Hint="Quita graves por debajo de esta frecuencia (voz más fina)." />
                <CheckBox Content="Paso bajo (quitar agudos)" IsChecked="{Binding LowPassEnabled}" Margin="0,4,0,0" />
                <controls:ParamSlider Label="Paso bajo" Minimum="1000" Maximum="12000" Step="100" DefaultValue="6000"
                                      Value="{Binding LowPassHz}" Format="{}{0:0} Hz" IsEnabled="{Binding LowPassEnabled}"
                                      Hint="Quita agudos por encima de esta frecuencia (voz apagada, de radio o lejana)." />
                <controls:ParamSlider Label="Presencia" Minimum="-12" Maximum="12" Step="0.5" DefaultValue="0"
                                      Value="{Binding PresenceDb}" Format="{}{0:+0.#;-0.#;0} dB"
                                      Hint="Realza o atenúa la zona de 1,8 kHz (voz más «delante»)." />
                <controls:ParamSlider Label="Agudos" Minimum="-12" Maximum="12" Step="0.5" DefaultValue="0"
                                      Value="{Binding HighShelfDb}" Format="{}{0:+0.#;-0.#;0} dB" />

                <TextBlock Text="Espacio" Style="{StaticResource SubHeader}" />
                <controls:ParamSlider Label="Eco (retardo)" Minimum="0" Maximum="1000" Step="10" DefaultValue="250"
                                      Value="{Binding EchoMs}" Format="{}{0:0} ms" OffText="apagado" />
                <controls:ParamSlider Label="Eco (repeticiones)" Minimum="0" Maximum="0.9" Step="0.01" DefaultValue="0.3"
                                      Value="{Binding EchoFeedback}" Format="{}{0:P0}"
                                      Hint="Realimentación: cuánto se repite el eco." />
                <controls:ParamSlider Label="Eco (mezcla)" Minimum="0" Maximum="1" Step="0.01" DefaultValue="0"
                                      Value="{Binding EchoMix}" Format="{}{0:P0}" OffText="apagado" />
                <controls:ParamSlider Label="Reverb (mezcla)" Minimum="0" Maximum="1" Step="0.01" DefaultValue="0"
                                      Value="{Binding ReverbMix}" Format="{}{0:P0}" OffText="apagada" />
                <controls:ParamSlider Label="Reverb (tamaño)" Minimum="0" Maximum="1" Step="0.01" DefaultValue="0.5"
                                      Value="{Binding ReverbSize}" Format="{}{0:P0}"
                                      Hint="De habitación pequeña a catedral." />

                <TextBlock Text="Salida" Style="{StaticResource SubHeader}" />
                <controls:ParamSlider Label="Ganancia" Minimum="-12" Maximum="12" Step="0.5" DefaultValue="0"
                                      Value="{Binding OutputGainDb}" Format="{}{0:+0.#;-0.#;0} dB"
                                      Hint="Volumen final de esta voz." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
