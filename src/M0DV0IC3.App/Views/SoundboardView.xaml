<UserControl x:Class="M0DV0IC3.App.Views.SoundboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:M0DV0IC3.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SoundboardViewModel}"
             AllowDrop="True" Background="Transparent"
             DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <WrapPanel DockPanel.Dock="Top" Margin="6,4,6,10">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddSoundCommand}" Margin="0,0,8,0" AutomationProperties.Name="Añadir sonido">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Añadir sonido" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding StopAllCommand}" Margin="0,0,20,0" ToolTip="Parar todos los sonidos (Ctrl+Alt+S por defecto)" AutomationProperties.Name="Parar todo">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Parar todo" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Volumen general" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Slider Width="160" Minimum="0" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.1"
                        Value="{Binding MasterVolume}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding MasterVolume, StringFormat={}{0:P0}}" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="10,0,0,0" Width="50" />
            </WrapPanel>

            <Border DockPanel.Dock="Top" Style="{StaticResource WarningBox}" Margin="6,0,6,10"
                    Visibility="{Binding DataContext.IsRunning, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToCollapsed}}">
                <TextBlock Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                           Text="El audio está parado: los sonidos no se oirán hasta que funcione (mira el estado arriba)." />
            </Border>

            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Sounds}" Margin="0,0,6,12" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SoundItemViewModel}">
                                <Grid Margin="6">
                                    <Button Style="{StaticResource SoundTileButton}" Command="{Binding PlayCommand}" AutomationProperties.Name="{Binding Name}"
                                            IsEnabled="{Binding IsReady}" ToolTip="Clic para reproducir">
                                        <StackPanel Margin="10,0">
                                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="12" HorizontalAlignment="Center"
                                                       Foreground="{StaticResource LimeBrush}" Margin="0,0,0,5" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextAlignment="Center"
                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" TextAlignment="Center" Margin="0,4,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE713;" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,3,3,0" Width="24" Height="24" FontSize="11"
                                            Command="{Binding EditCommand}" ToolTip="Nombre, volumen, atajo..." />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="2" CornerRadius="12" Margin="6"
                        Padding="24" VerticalAlignment="Top" MinHeight="160"
                        Visibility="{Binding HasSounds, Converter={StaticResource BoolToCollapsed}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="32" HorizontalAlignment="Center"
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="Arrastra aquí archivos de audio o pulsa «Añadir sonido»" FontSize="15" Margin="0,10,0,4"
                                   HorizontalAlignment="Center" />
                        <TextBlock Style="{StaticResource MutedText}" HorizontalAlignment="Center" TextAlignment="Center">
                            <Run Text="Formatos:" />
                            <Run Text="{Binding SupportedFormatsText, Mode=OneWay}" />
                            <Run Text="(máx. 2 minutos)." />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border x:Name="DropOverlay" Visibility="Collapsed" Background="#D9120B1C" BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="2" CornerRadius="12" Margin="6" IsHitTestVisible="False">
                    <TextBlock Text="Suelta para añadir al soundboard" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentTextBrush}" />
                </Border>
            </Grid>
        </DockPanel>

        <!-- Detalles del sonido elegido con el engranaje -->
        <Border Grid.Column="1" Width="320" Margin="12,0,0,0" Style="{StaticResource CardBorder}"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}">
            <StackPanel DataContext="{Binding Selected}" d:DataContext="{d:DesignInstance Type=vm:SoundItemViewModel}">
                <Grid>
                    <TextBlock Text="Sonido" Style="{StaticResource SectionHeader}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE711;" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Command="{Binding DataContext.CloseDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            ToolTip="Cerrar" />
                </Grid>

                <TextBlock Text="Nombre" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" />

                <TextBlock Text="Volumen" Style="{StaticResource FieldLabel}" Margin="2,14,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="0" Maximum="2" TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.1"
                            Value="{Binding Volume}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Volume, StringFormat={}{0:P0}}" Style="{StaticResource MutedText}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>

                <TextBlock Text="Atajo de teclado" Style="{StaticResource FieldLabel}" Margin="2,14,0,4" />
                <Grid DataContext="{Binding Hotkey}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding GestureText}" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Content="Cambiar" Command="{Binding ChangeCommand}" Margin="8,0,0,0"
                            ToolTip="Pulsa y luego la combinación (Esc cancela, Retroceso quita el atajo)" />
                    <Button Grid.Column="2" Content="Quitar" Command="{Binding ClearCommand}" Margin="6,0,0,0" />
                </Grid>
                <TextBlock Text="{Binding Hotkey.Error}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                           Visibility="{Binding Hotkey.HasError, Converter={StaticResource BoolToVisible}}" />

                <WrapPanel Margin="0,18,0,0">
                    <Button Command="{Binding PlayCommand}" IsEnabled="{Binding IsReady}" Margin="0,0,8,8" AutomationProperties.Name="Probar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Probar" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding StopCommand}" Margin="0,0,8,8" AutomationProperties.Name="Parar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Parar" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeleteCommand}" Margin="0,0,0,8" AutomationProperties.Name="Borrar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource ErrorBrush}" />
                            <TextBlock Text="Borrar" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0">
                    <Run Text="Duración:" />
                    <Run Text="{Binding DurationText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding LoadError}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisible}}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
