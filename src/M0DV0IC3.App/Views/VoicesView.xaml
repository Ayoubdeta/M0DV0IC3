<UserControl x:Class="M0DV0IC3.App.Views.VoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:M0DV0IC3.App.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:M0DV0IC3.App.ViewModels"
             xmlns:views="clr-namespace:M0DV0IC3.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:VoicesViewModel}">
    <UserControl.Resources>
        <!-- Tarjeta: el icono y el borde toman el color de su grupo -->
        <DataTemplate x:Key="VoiceCardTemplate" DataType="{x:Type vm:VoiceCardViewModel}">
            <Grid x:Name="Card" Visibility="{Binding IsShown, Converter={StaticResource BoolToVisible}}">
            <Button Style="{StaticResource VoiceCardButton}" AutomationProperties.Name="{Binding Name}"
                    Tag="{Binding Category, Converter={StaticResource CategoryAccent}}"
                    Command="{Binding DataContext.ActivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <Button.ToolTip>
                    <TextBlock>
                        <Run Text="{l:T 'Usar la voz'}" />
                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                </Button.ToolTip>
                <StackPanel>
                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource EmojiFont}" FontSize="38" HorizontalAlignment="Center"
                               Foreground="{Binding Category, Converter={StaticResource CategoryAccent}}" />
                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                    <Border CornerRadius="8" Background="#1FB478FF" Padding="7,1" HorizontalAlignment="Center" Margin="0,5,0,0"
                            Visibility="{Binding HotkeyHint, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Text="{Binding HotkeyHint}" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" />
                    </Border>
                </StackPanel>
            </Button>
            <!-- Estrella de favorita: se ve al pasar el ratón por la tarjeta, o siempre si ya es favorita -->
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0" Width="26" Height="26"
                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" Cursor="Hand" Focusable="False">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <TextBlock x:Name="Star" Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                <Setter TargetName="Star" Property="Text" Value="&#xE735;" />
                                <Setter TargetName="Star" Property="Foreground" Value="{StaticResource LimeBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Star" Property="Foreground" Value="{StaticResource LimeBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="ToolTip" Value="Añadir a favoritas" />
                        <Setter Property="AutomationProperties.Name" Value="Añadir a favoritas" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=Card}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="ToolTip" Value="Quitar de favoritas" />
                                <Setter Property="AutomationProperties.Name" Value="Quitar de favoritas" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            </Grid>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="WrapPanelTemplate">
            <WrapPanel />
        </ItemsPanelTemplate>

        <!-- Cabecera de un grupo: barra con su color, título y subtítulo -->
        <DataTemplate x:Key="GroupTemplate" DataType="{x:Type vm:VoiceGroupViewModel}">
            <StackPanel Margin="0,0,0,14" Visibility="{Binding HasShownCards, Converter={StaticResource BoolToVisible}}">
                <StackPanel Orientation="Horizontal" Margin="8,4,0,2">
                    <Border Width="4" Height="20" CornerRadius="2" Margin="0,0,10,0" VerticalAlignment="Center"
                            Background="{Binding Category, Converter={StaticResource CategoryAccent}}" />
                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource HeadingFont}" FontSize="17" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" FontSize="12.5" Margin="12,1,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource VoiceCardTemplate}"
                              ItemsPanel="{StaticResource WrapPanelTemplate}" Focusable="False" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <WrapPanel DockPanel.Dock="Top" Margin="2,0,6,8">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewVoiceCommand}" Margin="0,0,8,8" AutomationProperties.Name="{l:T 'Nueva voz'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{l:T 'Nueva voz'}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding EditCommand}" Margin="0,0,8,8" ToolTip="{l:T 'Editar la voz personalizada seleccionada'}" AutomationProperties.Name="{l:T 'Editar'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{l:T 'Editar'}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding DuplicateCommand}" Margin="0,0,8,8" ToolTip="{l:T 'Crear una copia editable de la voz seleccionada'}" AutomationProperties.Name="{l:T 'Duplicar'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{l:T 'Duplicar'}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding DeleteCommand}" Margin="0,0,20,8" ToolTip="{l:T 'Borrar la voz personalizada seleccionada'}" AutomationProperties.Name="{l:T 'Borrar'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{l:T 'Borrar'}" />
                    </StackPanel>
                </Button>
                <ToggleButton Style="{StaticResource Chip}" Tag="&#xE734;" IsChecked="{Binding FavoritesOnly}" Margin="0,0,8,8"
                              AutomationProperties.Name="{l:T 'Solo favoritas'}" VerticalAlignment="Center"
                              ToolTip="{l:T 'Muestra solo las voces con estrella. Voz aleatoria y voz anterior / siguiente eligen entonces entre ellas.'}">
                    <TextBlock Text="{l:T 'Favoritas'}" />
                </ToggleButton>
                <ToggleButton Style="{StaticResource Chip}" Tag="&#xE8B1;" IsChecked="{Binding RandomEnabled}" Margin="0,0,6,8" AutomationProperties.Name="{l:T 'Voz aleatoria'}"
                              VerticalAlignment="Center"
                              ToolTip="{l:T 'Voz aleatoria: va cambiando sola de voz mientras hablas (Ctrl+Alt+R por defecto). Se salta la voz invertida.'}">
                    <TextBlock Text="{l:T 'Voz aleatoria'}" />
                </ToggleButton>
                <ComboBox ItemsSource="{Binding RandomIntervals}" DisplayMemberPath="Label" SelectedValuePath="Seconds"
                          SelectedValue="{Binding RandomSeconds}" Width="150" Margin="0,0,20,8" VerticalAlignment="Center"
                          ToolTip="{l:T 'Cada cuánto cambia la voz aleatoria'}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center"
                            ToolTip="{l:T 'Mientras mantienes pulsado ese atajo suena esta voz; al soltarlo vuelve la que tenías (o ninguna, si estaba apagada). El atajo se cambia en Atajos.'}">
                    <TextBlock Text="{Binding HoldKeyText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox ItemsSource="{Binding HoldVoiceChoices}" SelectedItem="{Binding HoldVoice}" Width="180"
                              AutomationProperties.Name="{l:T 'Voz al mantener pulsado'}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:VoiceCardViewModel}">
                                <TextBlock>
                                    <Run Text="{Binding Icon, Mode=OneWay}" FontFamily="{StaticResource EmojiFont}" />
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </WrapPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource MutedText}" FontSize="12.5" Margin="4,0,6,10"
                       Text="{l:T 'Haz clic en una voz para usarla y en su estrella para guardarla en favoritas. Las voces incluidas no se pueden editar: duplícalas para crear tu versión.'}" />

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,12">
                    <Border Style="{StaticResource CardBorder}" Margin="6,0,6,14" Padding="16,12"
                            Visibility="{Binding ShowNoFavoritesHint, Converter={StaticResource BoolToVisible}}">
                        <TextBlock TextWrapping="Wrap"
                                   Text="{l:T 'Todavía no tienes voces favoritas. Quita el filtro «Favoritas», pasa el ratón por una voz y pulsa su estrella.'}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource GroupTemplate}" Focusable="False" />

                    <StackPanel Visibility="{Binding ShowCustomSection, Converter={StaticResource BoolToVisible}}">
                    <StackPanel Orientation="Horizontal" Margin="8,4,0,2">
                        <Border Width="4" Height="20" CornerRadius="2" Margin="0,0,10,0" VerticalAlignment="Center"
                                Background="{StaticResource CustomAccentBrush}" />
                        <TextBlock Text="{l:T 'Mis voces'}" FontFamily="{StaticResource HeadingFont}" FontSize="17" VerticalAlignment="Center" />
                        <TextBlock Text="{l:T 'Las que has creado o duplicado'}" Style="{StaticResource MutedText}" FontSize="12.5" Margin="12,1,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Custom}" ItemTemplate="{StaticResource VoiceCardTemplate}"
                                  ItemsPanel="{StaticResource WrapPanelTemplate}" Focusable="False" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="8,6,0,0"
                               Text="{l:T 'Todavía no tienes voces propias. Pulsa «Nueva voz», o elige una voz y pulsa «Duplicar».'}"
                               Visibility="{Binding ShowNoCustomHint, Converter={StaticResource BoolToVisible}}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <Border Grid.Column="1" Width="440" Margin="14,0,0,0" Style="{StaticResource CardBorder}" Padding="18,14"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisible}}">
            <views:VoiceEditorView DataContext="{Binding Editor}" />
        </Border>
    </Grid>
</UserControl>
