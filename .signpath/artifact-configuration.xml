<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuración de artefacto para SignPath (cópiala en el proyecto de SignPath, ver SIGNING.md).
    Solo se firman los binarios propios de M0DV0IC3: las DLL de .NET ya vienen firmadas por Microsoft
    y las de terceros (NAudio, CommunityToolkit, H.NotifyIcon, rnnoise) no se firman con nuestro certificado.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="M0DV0IC3.exe" />
      <include path="M0DV0IC3.dll" />
      <include path="M0DV0IC3.Audio.dll" />
      <include path="M0DV0IC3.Dsp.dll" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
